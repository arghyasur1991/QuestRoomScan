// GPU triplane grid sampling for object reconstruction.
// Two kernels:
//   SampleTriplane        — samples at uniform 3D grid points (Pass 1 density)
//   SampleAtPositions     — samples at arbitrary 3D positions  (Pass 2 vertex colors)
// Both produce (N, 3*C) concatenated triplane features via bilinear interpolation.
//
// Dispatch: 1D over total points, ceil(totalPoints / 64)

#pragma kernel SampleTriplane
#pragma kernel SampleAtPositions

StructuredBuffer<float> _SceneCodes;  // [3 * C * H * W]
uint _NumPlanes;   // 3
uint _Channels;    // 40
uint _PlaneH;      // 64
uint _PlaneW;      // 64

// Grid-specific
uint _Resolution;
uint _TotalPoints;
uint _GridOffset;  // flat index offset for chunked dispatch

// Position-specific
StructuredBuffer<float> _Positions;   // [N * 3] packed xyz
uint _NumPositions;
uint _PositionOffset;

RWStructuredBuffer<float> _OutputFeatures;

float BilinearSample(uint planeIdx, uint channel, float u, float v)
{
    int pw = (int)_PlaneW;
    int ph = (int)_PlaneH;
    int u0 = clamp((int)floor(u), 0, pw - 1);
    int v0 = clamp((int)floor(v), 0, ph - 1);
    int u1 = min(u0 + 1, pw - 1);
    int v1 = min(v0 + 1, ph - 1);
    float fu = saturate(u - u0);
    float fv = saturate(v - v0);

    uint base_off = planeIdx * _Channels * _PlaneH * _PlaneW + channel * _PlaneH * _PlaneW;
    float val00 = _SceneCodes[base_off + v0 * pw + u0];
    float val01 = _SceneCodes[base_off + v1 * pw + u0];
    float val10 = _SceneCodes[base_off + v0 * pw + u1];
    float val11 = _SceneCodes[base_off + v1 * pw + u1];

    return val00 * (1 - fu) * (1 - fv)
         + val10 * fu * (1 - fv)
         + val01 * (1 - fu) * fv
         + val11 * fu * fv;
}

void SamplePoint(float x, float y, float z, uint outBase)
{
    float halfW = _PlaneW * 0.5 - 0.5;
    float halfH = _PlaneH * 0.5 - 0.5;

    // UV coords matching F.grid_sample(align_corners=False): px = pos*N + N/2 - 0.5
    float2 uvs[3];
    uvs[0] = float2(x * _PlaneW + halfW, y * _PlaneH + halfH);
    uvs[1] = float2(x * _PlaneW + halfW, z * _PlaneH + halfH);
    uvs[2] = float2(y * _PlaneW + halfW, z * _PlaneH + halfH);

    [unroll]
    for (uint p = 0; p < 3; p++)
    {
        for (uint c = 0; c < _Channels; c++)
        {
            _OutputFeatures[outBase + p * _Channels + c] =
                BilinearSample(p, c, uvs[p].x, uvs[p].y);
        }
    }
}

// Kernel 1: Uniform grid sampling for density field (Pass 1)
[numthreads(64, 1, 1)]
void SampleTriplane(uint3 id : SV_DispatchThreadID)
{
    uint localIdx = id.x;
    if (localIdx >= _TotalPoints) return;

    uint globalIdx = _GridOffset + localIdx;
    uint res = _Resolution;
    uint ix = globalIdx % res;
    uint iy = (globalIdx / res) % res;
    uint iz = globalIdx / (res * res);

    float invResM1 = 1.0 / (res - 1);
    float x = ix * invResM1 - 0.5;
    float y = iy * invResM1 - 0.5;
    float z = iz * invResM1 - 0.5;

    uint featureDim = _NumPlanes * _Channels;
    SamplePoint(x, y, z, localIdx * featureDim);
}

// Kernel 2: Arbitrary position sampling for vertex colors (Pass 2)
[numthreads(64, 1, 1)]
void SampleAtPositions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _NumPositions) return;

    uint globalIdx = _PositionOffset + id.x;
    float x = _Positions[globalIdx * 3 + 0];
    float y = _Positions[globalIdx * 3 + 1];
    float z = _Positions[globalIdx * 3 + 2];

    uint featureDim = _NumPlanes * _Channels;
    SamplePoint(x, y, z, id.x * featureDim);
}
