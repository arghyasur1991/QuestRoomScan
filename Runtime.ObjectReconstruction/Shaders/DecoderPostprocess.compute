// GPU postprocessing for NeRF decoder output.
//   ExtractRawDensity — stores raw (pre-activation) density for smoothing
//   SmoothRaw        — 3x3x3 blur in log-space (before exp), where INT8 noise is uniform
//   CopyBuffer       — identity copy for odd-pass ping-pong
//   ActivateDensity  — applies exp(smoothed_raw - 1) to produce final density
//   ExtractDensity   — fused path: exp(raw-1) in one pass (when smoothing disabled)
//   ExtractColors    — sigmoid on RGB channels

#pragma kernel ExtractRawDensity
#pragma kernel SmoothRaw
#pragma kernel CopyBuffer
#pragma kernel ActivateDensity
#pragma kernel ExtractDensity
#pragma kernel ExtractColors

StructuredBuffer<float> _DecoderOutput; // (N, 4) flattened: [density, r, g, b]

RWStructuredBuffer<float> _DensityVolume; // totalPoints floats
StructuredBuffer<float> _RawInput;        // source for smoothing / activation
RWStructuredBuffer<float> _RawOutput;     // destination for smoothing
RWStructuredBuffer<float> _ColorOutput;   // numVerts * 3 floats

uint _Offset;
uint _Count;
uint _SmoothRes;

// Store raw decoder density output without activation (for smoothing path)
[numthreads(256, 1, 1)]
void ExtractRawDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    _RawOutput[_Offset + id.x] = _DecoderOutput[id.x * 4];
}

// 3x3x3 Gaussian-weighted blur on RAW (pre-exp) density values.
// INT8 quantization noise is additive and uniform in this space,
// so a linear filter cleanly removes it without smudging edges.
[numthreads(256, 1, 1)]
void SmoothRaw(uint3 id : SV_DispatchThreadID)
{
    uint res = _SmoothRes;
    uint total = res * res * res;
    if (id.x >= total) return;

    uint ix = id.x % res;
    uint iy = (id.x / res) % res;
    uint iz = id.x / (res * res);

    float sum = 0.0;
    float wt = 0.0;

    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        int nx = (int)ix + dx;
        int ny = (int)iy + dy;
        int nz = (int)iz + dz;
        if (nx < 0 || nx >= (int)res ||
            ny < 0 || ny >= (int)res ||
            nz < 0 || nz >= (int)res)
            continue;

        int dist = abs(dx) + abs(dy) + abs(dz);
        float w = dist == 0 ? 8.0 :
                  dist == 1 ? 4.0 :
                  dist == 2 ? 2.0 : 1.0;

        sum += _RawInput[(uint)nz * res * res + (uint)ny * res + (uint)nx] * w;
        wt += w;
    }

    _RawOutput[id.x] = sum / wt;
}

[numthreads(256, 1, 1)]
void CopyBuffer(uint3 id : SV_DispatchThreadID)
{
    uint total = _SmoothRes * _SmoothRes * _SmoothRes;
    if (id.x >= total) return;
    _RawOutput[id.x] = _RawInput[id.x];
}

// Apply exp(raw - 1) activation after smoothing
[numthreads(256, 1, 1)]
void ActivateDensity(uint3 id : SV_DispatchThreadID)
{
    uint total = _SmoothRes * _SmoothRes * _SmoothRes;
    if (id.x >= total) return;
    float clamped = clamp(_RawInput[id.x] - 1.0, -15.0, 15.0);
    _DensityVolume[id.x] = exp(clamped);
}

// Fused path: extract + activate in one pass (when smoothing is disabled)
[numthreads(256, 1, 1)]
void ExtractDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    float raw = _DecoderOutput[id.x * 4];
    float clamped = clamp(raw - 1.0, -15.0, 15.0);
    _DensityVolume[_Offset + id.x] = exp(clamped);
}

[numthreads(256, 1, 1)]
void ExtractColors(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    uint inBase = id.x * 4;
    float r = 1.0 / (1.0 + exp(-_DecoderOutput[inBase + 1]));
    float g = 1.0 / (1.0 + exp(-_DecoderOutput[inBase + 2]));
    float b = 1.0 / (1.0 + exp(-_DecoderOutput[inBase + 3]));
    uint outBase = (_Offset + id.x) * 3;
    _ColorOutput[outBase + 0] = r;
    _ColorOutput[outBase + 1] = g;
    _ColorOutput[outBase + 2] = b;
}
